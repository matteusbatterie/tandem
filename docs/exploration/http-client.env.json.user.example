{
  "dev": { // Access docs/exploration/README.md for more information on how to generate these values.  
    "trelloKey": "YOUR_TRELLO_API_KEY",
    "trelloToken": "YOUR_TRELLO_TOKEN",
    "trelloBoardId": "YOUR_TRELLO_BOARD_ID", // The ID of the Trello board you want to access the Cards for."
    "githubToken": "YOUR_GITHUB_TOKEN",
    "githubUser": "YOUR_GITHUB_USERNAME",
    "githubRepo": "GITHUB_REPO", // The name of the repository you want to access the Issues for.
    "githubUserAgent": "YOUR_USER_AGENT", // A user agent string to identify your application when making requests to the GitHub API.
    "webhookUrl": "YOUR_WEBHOOK_URL" // The URL of the webhook you want to send the data to."
  }
} 